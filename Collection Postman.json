                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/membres/inscription",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "membres",
                "inscription"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Ben Ali\",\n  \"prenom\": \"Sami\",\n  \"email\": \"{{email1}}\",\n  \"motDePasse\": \"{{motDePasse1}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Génère un email unique et mémorise membreId."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email1', 'chef.' + Date.now() + '@chilla.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.IDmem !== undefined) pm.collectionVariables.set('membreId', j.IDmem);"
                ]
              }
            }
          ]
